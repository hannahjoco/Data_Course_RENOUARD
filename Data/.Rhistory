ggplot(ugly, aes(x = wt, y = mpg)) +
# giant ugly background blocks
annotate("rect", xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf,
fill = "hotpink", alpha = 0.25) +
annotate("rect", xmin = 2, xmax = 4.5, ymin = 10, ymax = 35,
fill = "chartreuse", alpha = 0.25) +
# too many geoms for no reason
geom_line(aes(group = cyl, color = hp), linewidth = 2, alpha = 0.7) +
geom_point(aes(size = qsec, color = hp, shape = factor(gear)), alpha = 0.9) +
geom_text(aes(label = car, angle = hp), size = 3, color = "yellow") +
geom_smooth(aes(linetype = factor(vs)), method = "lm", se = TRUE,
color = "cyan", linewidth = 1.5) +
# terrible faceting choice
facet_wrap(~ carb, ncol = 3) +
# wrong / overwhelming scales
scale_color_gradient(low = "red", high = "limegreen") +
scale_size_continuous(range = c(1, 15)) +
labs(
title = "THE WORST MPG PLOT EVER CONCEIVED",
subtitle = "Weight vs Mileage vs Horsepower vs Quarter Mile vs Gear vs Vibes",
x = "Car Heft But In A Bad Way",
y = "Miles Per Gallon Or Whatever",
color = "Horse Chaos",
size = "Speed-ish",
shape = "Gear Situation",
linetype = "Mystery Engine Mood",
caption = "This figure bravely ignores every principle of visual communication."
) +
theme_minimal() +
theme(
plot.title = element_text(size = 24, color = "purple", face = "bold.italic", hjust = 0.5),
plot.subtitle = element_text(size = 16, color = "orange", face = "bold", hjust = 0.1),
axis.text.x = element_text(angle = 75, hjust = 1, size = 14, color = "blue"),
axis.text.y = element_text(size = 6, color = "red"),
axis.title = element_text(size = 18, color = "darkgreen", face = "bold"),
panel.grid.major = element_line(color = "gold", linewidth = 1.2),
panel.grid.minor = element_line(color = "black", linewidth = 0.8, linetype = "dotted"),
strip.text = element_text(size = 16, color = "white", face = "bold"),
strip.background = element_rect(fill = "brown", color = "cyan", linewidth = 2),
legend.position = "bottom",
legend.background = element_rect(fill = "gray20", color = "yellow", linewidth = 2),
legend.text = element_text(color = "white", size = 11),
legend.title = element_text(color = "magenta", size = 13, face = "bold"),
plot.background = element_rect(fill = "lightblue", color = "red", linewidth = 4),
panel.background = element_rect(fill = "gray85", color = "orange", linewidth = 3)
)
library(ggplot2)
# make car names into a column
ugly <- mtcars
ugly$car <- rownames(mtcars)
ggplot(ugly, aes(x = wt, y = mpg)) +
# giant ugly background blocks
annotate("rect", xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf,
fill = "hotpink", alpha = 0.25) +
annotate("rect", xmin = 2, xmax = 4.5, ymin = 10, ymax = 35,
fill = "chartreuse", alpha = 0.25) +
# too many geoms for no reason
geom_line(aes(group = cyl, color = hp), linewidth = 2, alpha = 0.7) +
geom_point(aes(size = qsec, color = hp, shape = factor(gear)), alpha = 0.9) +
geom_text(aes(label = car, angle = hp), size = 3, color = "yellow") +
geom_smooth(aes(linetype = factor(vs)), method = "lm", se = TRUE,
color = "cyan", linewidth = 1.5) +
# terrible faceting choice
facet_wrap(~ carb, ncol = 3) +
# wrong / overwhelming scales
scale_color_gradient(low = "red", high = "limegreen") +
scale_size_continuous(range = c(1, 15)) +
labs(
title = "THE WORST MPG PLOT EVER CONCEIVED",
subtitle = "Weight vs Mileage vs Horsepower vs Quarter Mile vs Gear vs Vibes",
x = "Car Heft But In A Bad Way",
y = "Miles Per Gallon Or Whatever",
color = "Horse Chaos",
size = "Speed-ish",
